# ====================================================
# TalentFlow Environment Variables Template
# Copy this file to .env (do NOT commit .env with real secrets!)
# ====================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=24h

# Anthropic Claude AI Configuration
# Required: valid Anthropic API key starting with sk-ant-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AI Model selection (read dynamically as specified in assignment)
AI_MODEL=claude-3-5-sonnet-20241022
# AI Request timeout in milliseconds (assignment specifies 15s)
AI_TIMEOUT_MS=15000
