# ====================================================
# TalentFlow Backend Environment Variables
# Copy to server/.env (never commit server/.env)
# ====================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URL for Prisma with SQLite
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=24h

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT_MS=15000

# Google Gemini API Configuration (used in priority when GEMINI_API_KEY is set)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Offline demo mode (no API key, no external call, deterministic schema-validated data)
# Set ANTHROPIC_API_KEY=mock-key-development or GEMINI_API_KEY=mock-key-development
